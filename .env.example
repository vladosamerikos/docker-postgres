POSTGRES_VERSION=13
POSTGRES_HOSTNAME=postgres13
HOST_POSTGRES_PORT=5413
# Publish mode: none, host (127.0.0.1), or lan (0.0.0.0). Activate one profile.
# Run docker compose down before changing modes.
POSTGRES_PORT_MODE=host
COMPOSE_PROFILES=${POSTGRES_PORT_MODE}
COMPOSE_FILE=docker-compose.yml
POSTGRES_LAN_HOST=

# Administrator credentials. Set a password before starting Compose.
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Store generated/rotated credentials as JSON Lines in .credentials (plaintext, mode 600).
storecredentials=false

CONTAINER_NAME=postgres13
COMPOSE_PROJECT_NAME=postgres13
POSTGRES_LIMIT_CPUS=2
POSTGRES_LIMIT_MEMORY=4G
POSTGRES_RESERVATION_CPUS=0.5
POSTGRES_RESERVATION_MEMORY=200M
